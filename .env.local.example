# Dodo Payments — get your API key from dodopayments.com dashboard → Developer → API
DODO_API_KEY=sk_...

# Set to "live" when ready to accept real payments, "test" for sandbox
DODO_MODE=test
NEXT_PUBLIC_DODO_MODE=test

# Your deployed site URL (used for the return_url after checkout)
NEXT_PUBLIC_SITE_URL=https://lazygirlai.vercel.app

# Payload CMS (blog posts live here — run `npm run seed` to import seed data)
DATABASE_URL=
PAYLOAD_SECRET=
# Optional: Vercel Blob for media uploads in admin
BLOB_READ_WRITE_TOKEN=
